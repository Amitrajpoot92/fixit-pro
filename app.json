{
  "expo": {
    "name": "FixitPro",
    "slug": "FixitPro",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/platform-img/logo.png",
    "splash": {
      "image": "./assets/platform-img/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/platform-img/logo.png"
      },
      "package": "com.amitrajpoot.FixitPro"
    },
    "web": {
      "favicon": "./assets/platform-img/logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "2d8e01e3-5f18-4b40-8e38-ddff14507a58"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you choose images.",
          "cameraPermission": "The app accesses your camera to let you take photos."
        }
      ],
      "expo-font"
    ]
  }
}
