{
  "expo": {
    "name": "FixitPro",
    "slug": "FixitPro",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/platform-img/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/platform-img/adaptive-icon.png"
      },
      "package": "com.codewebx.fixitpro",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/platform-img/logo.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you choose images.",
          "cameraPermission": "The app accesses your camera to let you take photos.",
          "microphonePermission": "The app accesses your microphone for KYC verification."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/platform-img/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d82b1384-87d6-4bb5-8e60-60a5be5d7092"
      }
    },
    "owner": "mrfixitpro"
  }
}
